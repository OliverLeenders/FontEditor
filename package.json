{
  "name": "fonteditor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A browser font editor with Tunni-line curve control.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @fonteditor/playground dev",
    "test": "pnpm --filter \"./packages/*\" test",
    "test:watch": "pnpm --filter @fonteditor/geometry test:watch",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "fast-check": "^3.23.2",
    "vite": "^5.4.21"
  }
}
