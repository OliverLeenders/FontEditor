node_modules/
dist/
coverage/
*.tsbuildinfo

.DS_Store
Thumbs.db

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# The font checks in tools/ run under Python, and a virtual environment for them
# is the one thing in this repository that is neither JavaScript nor a font.
.venv*/
# And the checks import a module of their own, which Python compiles beside it.
__pycache__/

*.log
npm-debug.log*
pnpm-debug.log*
.pnpm-store/

# The desktop shell is a Rust crate, and cargo's build directory is gigabytes
# of compiled dependencies rebuilt from Cargo.lock on any machine that needs it.
apps/editor/src-tauri/target/
apps/editor/src-tauri/gen/

# ttfautohint, fetched for the desktop build by apps/editor/scripts/fetch-ttfautohint.mjs:
# a program for each platform, checked against the hashes in that script.
apps/editor/src-tauri/binaries/
