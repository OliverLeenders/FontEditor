{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Typewright",
  "version": "0.1.0",
  "identifier": "dev.typewright.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "node scripts/fetch-ttfautohint.mjs && pnpm dev",
    "beforeBuildCommand": "node scripts/fetch-ttfautohint.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Typewright",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": ["binaries/ttfautohint"],
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
