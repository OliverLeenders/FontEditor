{
  "name": "@typewright/font-io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reading and writing font binaries. The only package that knows a font parser exists.",
  "license": "GPL-3.0-or-later",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./binary": "./src/binary.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typewright/font-model": "workspace:*",
    "@typewright/geometry": "workspace:*",
    "opentype.js": "^2.0.0",
    "woff2-encoder": "^2.0.0"
  },
  "devDependencies": {
    "harfbuzzjs": "^1.6.1"
  }
}
