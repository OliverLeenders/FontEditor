{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM types exist for `surface.ts` alone, which owns the canvas element and
    // the frame loop. Everything in `draw.ts` goes through the hand-written
    // `Canvas2D` interface instead, so the drawing code cannot reach the DOM
    // even by accident — and can be handed a recording stub in tests.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
