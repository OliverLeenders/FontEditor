{
  "name": "@typewright/shaping",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Setting text with HarfBuzz, the shaper browsers and operating systems use. Loaded when text is set, not at startup.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typewright/font-io": "workspace:*",
    "@typewright/font-model": "workspace:*",
    "@typewright/view": "workspace:*",
    "harfbuzzjs": "^1.6.1"
  }
}
